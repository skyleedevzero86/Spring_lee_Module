<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sleekydz86.ftpserver.infrastructure.ftp.FtpTransferMapper">

    <resultMap id="ftpTransferResultMap" type="com.sleekydz86.ftpserver.domain.ftp.FtpTransfer">
        <result property="transferId.value" column="transfer_id"/>
        <result property="paymentRequestNo" column="payment_request_no"/>
        <result property="remotePath" column="remote_path"/>
        <result property="fileName" column="file_name"/>
        <result property="fileContent" column="file_content" jdbcType="BLOB"/>
        <result property="transferStatus" column="transfer_status" typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="errorMessage" column="error_message"/>
        <result property="retryCount" column="retry_count"/>
        <result property="maxRetries" column="max_retries"/>
        <result property="createdAt" column="created_at"/>
        <result property="startedAt" column="started_at"/>
        <result property="completedAt" column="completed_at"/>
    </resultMap>

    <parameterMap id="ftpTransferParamMap" type="map">
        <parameter property="inOperation" mode="IN" jdbcType="VARCHAR"/>
        <parameter property="transferId" mode="INOUT" jdbcType="VARCHAR"/>
        <parameter property="paymentRequestNo" mode="IN" jdbcType="VARCHAR"/>
        <parameter property="remotePath" mode="IN" jdbcType="VARCHAR"/>
        <parameter property="fileName" mode="IN" jdbcType="VARCHAR"/>
        <parameter property="fileContent" mode="IN" jdbcType="BLOB"/>
        <parameter property="transferStatus" mode="IN" jdbcType="VARCHAR"/>
        <parameter property="errorMessage" mode="IN" jdbcType="VARCHAR"/>
        <parameter property="retryCount" mode="IN" jdbcType="INTEGER"/>
        <parameter property="maxRetries" mode="IN" jdbcType="INTEGER"/>
        <parameter property="rtnCod" mode="INOUT" jdbcType="VARCHAR"/>
        <parameter property="errMsg" mode="INOUT" jdbcType="VARCHAR"/>
    </parameterMap>

    <select id="processFtpTransfer" statementType="CALLABLE" parameterMap="ftpTransferParamMap">
        { call SP_FTP_TRANSFER_CUD(
            :inOperation,
            :transferId,
            :paymentRequestNo,
            :remotePath,
            :fileName,
            :fileContent,
            :transferStatus,
            :errorMessage,
            :retryCount,
            :maxRetries,
            :rtnCod,
            :errMsg
        )}
    </select>

    <select id="selectFtpTransfer" resultMap="ftpTransferResultMap">
        SELECT transfer_id, payment_request_no, remote_path, file_name, file_content,
               transfer_status, error_message, retry_count, max_retries,
               created_at, started_at, completed_at
        FROM ftp_transfer
        WHERE transfer_id = #{transferId}
    </select>

    <select id="selectFtpTransfersByPaymentRequestNo" resultMap="ftpTransferResultMap">
        SELECT transfer_id, payment_request_no, remote_path, file_name, file_content,
               transfer_status, error_message, retry_count, max_retries,
               created_at, started_at, completed_at
        FROM ftp_transfer
        WHERE payment_request_no = #{paymentRequestNo}
        ORDER BY created_at DESC
    </select>

    <select id="selectFtpTransfersByStatus" resultMap="ftpTransferResultMap">
        SELECT transfer_id, payment_request_no, remote_path, file_name, file_content,
               transfer_status, error_message, retry_count, max_retries,
               created_at, started_at, completed_at
        FROM ftp_transfer
        WHERE transfer_status = #{transferStatus}
        ORDER BY created_at DESC
    </select>

    <select id="selectFailedFtpTransfers" resultMap="ftpTransferResultMap">
        SELECT transfer_id, payment_request_no, remote_path, file_name, file_content,
               transfer_status, error_message, retry_count, max_retries,
               created_at, started_at, completed_at
        FROM ftp_transfer
        WHERE transfer_status = 'FAILED'
        ORDER BY created_at DESC
    </select>

</mapper>
